# --- Base de datos / Docker Compose ---
POSTGRES_DB=mica
POSTGRES_USER=mica
POSTGRES_PASSWORD=mica
POSTGRES_PORT=5432
API_PORT=8000

# --- Aplicación ---
APP_ENV=demo
APP_TIMEZONE=America/Lima
LOG_LEVEL=INFO
# En local (sin Docker) usa localhost; en Compose se sobreescribe a db.
DATABASE_URL=postgresql+psycopg://mica:mica@localhost:5432/mica

# --- Secretos: cambiar antes de exponer la demo ---
SESSION_SECRET=dev-session-secret-change-me
PHONE_ENCRYPTION_KEY=dev-phone-encryption-key-change-me
PHONE_LOOKUP_KEY=dev-phone-lookup-key-change-me
SIMULATOR_SIGNING_SECRET=dev-simulator-secret-change-me
SESSION_TTL_HOURS=24
CSRF_ENABLED=true
GROQ_API_KEY=

# --- URLs y CORS ---
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,https://mock-tawny-tau.vercel.app

# --- Twilio / WhatsApp (MESSAGING_MODE=fake no contacta personas) ---
MESSAGING_MODE=fake
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+10000000000
TWILIO_WEBHOOK_PUBLIC_URL=
TWILIO_STATUS_PUBLIC_URL=

# --- Reglas de demo ---
RULES_VERSION=demo-1
WEEKLY_REPORT_LOCAL_TIME=20:00
STABILITY_WEEKS=8
SALES_DROP_THRESHOLD=0.30
DEMO_WEEKLY_INSTALLMENT_RATIO=0.20
# Límites de yapeo validados en el servidor (soles)
PAYMENT_LIMIT_PEN=500
DAILY_LIMIT_PEN=2000

# --- Trabajo durable ---
PROCESS_INBOX_INLINE=false
RUN_SCHEDULER_IN_WORKER=true
WORKER_POLL_SECONDS=5
WORKER_BATCH_SIZE=25
JOB_LEASE_SECONDS=120
SCHEDULER_INTERVAL_SECONDS=60

# --- Opcionales P1 ---
ENABLE_LLM=false
ENABLE_TTS=false
OPENAPI_DOCS_ENABLED=true
