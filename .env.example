# =====================================================================
#  Mica · Mi Negocio — variables de entorno
#  Copia este archivo a .env. Lo que no pongas toma el valor por defecto
#  del código (backend/app/core/config.py).
# =====================================================================

# ---------------------------------------------------------------------
# 1. Canal del agente (activa uno o ambos)
#    Por ahora Telegram; cuando aprueben WhatsApp, WHATSAPP_ENABLED=true.
# ---------------------------------------------------------------------
TELEGRAM_ENABLED=true
WHATSAPP_ENABLED=false

# --- Telegram (sin token, los envíos se simulan) ---
# Crea el bot con @BotFather (/newbot) y copia su token y su usuario (sin @).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# true: el worker lee los mensajes solo (no necesita URL pública).
# false: usa el webhook POST /api/v1/webhooks/telegram (requiere el secreto).
TELEGRAM_POLLING=true
TELEGRAM_WEBHOOK_SECRET=

# --- WhatsApp por Twilio (MESSAGING_MODE=fake no contacta personas) ---
MESSAGING_MODE=fake
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+10000000000
TWILIO_WEBHOOK_PUBLIC_URL=
TWILIO_STATUS_PUBLIC_URL=

# ---------------------------------------------------------------------
# 2. Base de datos y puertos (Docker Compose)
# ---------------------------------------------------------------------
POSTGRES_DB=mica
POSTGRES_USER=mica
POSTGRES_PASSWORD=mica
POSTGRES_PORT=5432
API_PORT=8000
# Solo para correr el backend sin Docker (Compose la reemplaza por "db").
# El puerto debe coincidir con POSTGRES_PORT.
DATABASE_URL=postgresql+psycopg://mica:mica@localhost:5432/mica

# ---------------------------------------------------------------------
# 3. URLs y CORS
# ---------------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,https://mock-tawny-tau.vercel.app

# ---------------------------------------------------------------------
# 4. Secretos — OBLIGATORIO cambiarlos en el VPS
#    (32+ caracteres aleatorios: python -c "import secrets;print(secrets.token_urlsafe(32))")
#    Con PUBLIC_BASE_URL https:// el backend no arranca con estos valores.
# ---------------------------------------------------------------------
SESSION_SECRET=dev-session-secret-change-me
PHONE_ENCRYPTION_KEY=dev-phone-encryption-key-change-me
PHONE_LOOKUP_KEY=dev-phone-lookup-key-change-me
SIMULATOR_SIGNING_SECRET=dev-simulator-secret-change-me

# =====================================================================
#  AVANZADO — normalmente no hace falta tocarlo (son los valores por defecto)
# =====================================================================

# --- Aplicación ---
APP_ENV=demo
APP_TIMEZONE=America/Lima
LOG_LEVEL=INFO
SESSION_TTL_HOURS=24
CSRF_ENABLED=true
OPENAPI_DOCS_ENABLED=true

# --- Límites de yapeo validados en el servidor (soles) ---
PAYMENT_LIMIT_PEN=500
DAILY_LIMIT_PEN=2000

# --- Reglas del reporte semanal ---
RULES_VERSION=demo-1
WEEKLY_REPORT_LOCAL_TIME=20:00
STABILITY_WEEKS=8
SALES_DROP_THRESHOLD=0.30
DEMO_WEEKLY_INSTALLMENT_RATIO=0.20

# --- Worker (inbox, trabajos programados y envíos) ---
PROCESS_INBOX_INLINE=false
RUN_SCHEDULER_IN_WORKER=true
WORKER_POLL_SECONDS=5
WORKER_BATCH_SIZE=25
JOB_LEASE_SECONDS=120
SCHEDULER_INTERVAL_SECONDS=60

# --- Voz (todavía no implementada) ---
ENABLE_TTS=false

# --- Reservado para el agente con IA (todavía ningún código lo usa) ---
# ENABLE_LLM=false
# GROQ_API_KEY=
